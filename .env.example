# AppSec Multi-Agent Framework — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------

# Primary LLM provider: groq | cerebras
LLM_PROVIDER=groq

# Groq API key — obtain from https://console.groq.com
GROQ_API_KEY=

# Cerebras API key — obtain from https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Override the model name (leave blank to use provider default)
# Groq default    : llama-3.1-70b-versatile
# Cerebras default: llama3.1-70b
LLM_MODEL=

# Fallback provider if the primary key is missing or the request fails
# Leave blank to disable fallback
LLM_FALLBACK_PROVIDER=

# ---------------------------------------------------------------------------
# Authorization
# ---------------------------------------------------------------------------

# Authorization ID — required for active scan phases.
# Use a reference number from your bug bounty scope agreement or pentest SOW.
# Example: AUTH-HACKERONE-2024-001
AUTHORIZATION_ID=

# ---------------------------------------------------------------------------
# Notification integrations (optional)
# ---------------------------------------------------------------------------

# Telegram bot token and chat ID for finding notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack webhook URL
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# HackerOne / Bugcrowd API (optional — for target selection)
# ---------------------------------------------------------------------------
H1_API_TOKEN=
CHAOS_API_KEY=

# ---------------------------------------------------------------------------
# Scan defaults (can also be set via CLI flags)
# ---------------------------------------------------------------------------

# quick | deep | nightly
SCAN_PROFILE=quick

# Maximum concurrent threads
MAX_THREADS=10

# Maximum HTTP requests per second
MAX_RATE_LIMIT=50
